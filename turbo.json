{
  "$schema": "https://turbo.build/schema.json",
  "concurrency": "4",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "build:base": {
      "dependsOn": ["^build", "^build:base"],
      "outputs": ["dist/index.js", "dist/index.cjs", "dist/index.d.ts", "dist/shared/**"]
    },
    "build:react": {
      "dependsOn": ["^build", "^build:react", "build:base"],
      "outputs": ["dist/react/**"]
    },
    "check-types": {
      "dependsOn": ["^check-types"]
    },
    "dev": {
      "persistent": true,
      "cache": false
    },
    "clean": {
      "cache": false
    }
  }
}
